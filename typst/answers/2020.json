              "kind": "code",
              "value": "S_AC = 0;\nS_BC = 0;\nS_CE = 0;\nS_DE = 0;\n\ncobegin {\n    A() {\n        A;\n        signal(S_AC);\n    }\n\n    B() {\n        B;\n        signal(S_BC);\n    }\n\n    C() {\n        wait(S_AC);\n        wait(S_BC);\n        C;\n        signal(S_CE);\n    }\n\n    D() {\n        D;\n        signal(S_DE);\n    }\n\n    E() {\n        wait(S_CE);\n        wait(S_DE);\n        E;\n    }\n} coend",
