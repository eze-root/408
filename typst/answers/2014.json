                [
                  {
                    "kind": "code",
                    "value": "mutex1",
                    "block": false,
                    "lang": "text"
                  },
                  {
                    "kind": "text",
                    "value": "：用于控制一个消费者进程连续取出10件产品的互斥，初值为1。"
                  }
                ],
                [
                  {
                    "kind": "code",
                    "value": "mutex2",
                    "block": false,
                    "lang": "text"
                  },
                  {
                    "kind": "text",
                    "value": "：用于进程单次互斥访问缓冲区，初值为1。"
                  }
                ],
                [
                  {
                    "kind": "code",
                    "value": "empty",
                    "block": false,
                    "lang": "text"
                  },
                  {
                    "kind": "text",
                    "value": "：表示缓冲区中的空位数量，初值为1000。"
                  }
                ],
                [
                  {
                    "kind": "code",
                    "value": "full",
                    "block": false,
                    "lang": "text"
                  },
                  {
                    "kind": "text",
                    "value": "：表示缓冲区中的产品数量，初值为0。"
                  }
                ]
              ]
            },
            {
              "kind": "heading",
              "children": [
                {
                  "kind": "text",
                  "value": "(2) 生产者进程的伪代码"
                }
              ]
            },
            {
              "kind": "code",
              "value": "producer() {\n    while (1) {\n        生产一个产品;\n        P(empty);          // 等待空位\n        P(mutex2);         // 互斥访问缓冲区\n        把产品放入缓冲区;\n        V(mutex2);         // 释放缓冲区访问权\n        V(full);           // 产品数加1\n    }\n}",
              "block": true,
              "lang": "text"
            },
            {
              "kind": "heading",
              "children": [
                {
                  "kind": "text",
                  "value": "(3) 消费者进程的伪代码"
                }
              ]
            },
            {
              "kind": "code",
              "value": "consumer() {\n    while (1) {\n        P(mutex1);         // 确保连续取10次产品期间独占\n        for (int i = 0; i < 10; i++) {\n            P(full);       // 等待产品\n            P(mutex2);     // 互斥访问缓冲区\n            从缓冲区取出一件产品;\n            V(mutex2);     // 释放缓冲区访问权\n            V(empty);      // 空位数加1\n            消费这件产品;\n        }\n        V(mutex1);         // 释放连续取产品的控制权\n    }\n}",
              "block": true,
              "lang": "text"
            }
