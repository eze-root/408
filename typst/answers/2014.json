                [
                  {
                    "kind": "text",
                    "value": "转移目标地址计算公式："
                  },
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "value": "PC + 4 + OFFSET × 4"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "value": "。  "
                  }
                ]
              ]
            },
            {
              "kind": "p",
              "children": [
                {
                  "kind": "group",
                  "children": [
                    {
                      "kind": "strong",
                      "children": [
                        {
                          "kind": "text",
                          "value": "理由"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "value": "：执行bne时PC自动加4，目标地址与当前PC+4的差值为-24，OFFSET为-6，故每个偏移单位对应4字节。"
                    }
                  ]
                }
              ]
            },
