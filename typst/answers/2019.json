    {
      "number": 41,
      "choice": null,
      "nodes": [
        {
          "kind": "group",
          "children": [
            {
              "kind": "p",
              "children": [
                {
                  "kind": "group",
                  "children": [
                    {
                      "kind": "text",
                      "value": "（1）先用快、慢指针找到链表中点，再原地逆置后半段，最后将前半段和逆置后的后半段交替合并。"
                    }
                  ]
                }
              ]
            },
            {
              "kind": "p",
              "children": [
                {
                  "kind": "group",
                  "children": [
                    {
                      "kind": "text",
                      "value": "（2）一种实现如下："
                    }
                  ]
                }
              ]
            },
            {
              "kind": "code",
              "value": "void reorderList(node *h) {\n    node *p, *q, *r, *s;\n    p = q = h;\n    while(q->next != NULL) { // 找到中间结点\n        p = p->next;\n        q = q->next;\n        if(q->next != NULL) {\n            q = q->next;\n        }\n    }\n    q = p->next;\n    p->next = NULL;\n    while(q != NULL) { // 后半部分原地逆置\n        r = q->next;\n        q->next = p->next;\n        p->next = q;\n        q = r;\n    }\n    s = h->next;\n    q = p->next;\n    p->next = NULL;\n    while(q != NULL) { // 逐个插入结点\n        r = q->next;\n        q->next = s->next;\n        s->next = q;\n        s = q->next;\n        q = r;\n    }\n}",
              "block": true,
              "lang": "c"
            },
            {
              "kind": "p",
              "children": [
                {
                  "kind": "text",
                  "value": "（3）时间复杂度为 O(n)，辅助空间复杂度为 O(1)。"
                }
              ]
            }
          ]
        }
      ]
    },
