              "kind": "p",
              "children": [
                {
                  "kind": "group",
                  "children": [
                    {
                      "kind": "text",
                      "value": "（1）信号量定义及初值："
                    }
                  ]
                }
              ]
            },
            {
              "kind": "list",
              "ordered": false,
              "items": [
                [
                  {
                    "kind": "code",
                    "value": "semaphore Full_A = x;",
                    "block": false,
                    "lang": "text"
                  },
                  {
                    "kind": "text",
                    "value": "  // A信箱中的邮件数"
                  }
                ],
                [
                  {
                    "kind": "code",
                    "value": "semaphore Empty_A = M - x;",
                    "block": false,
                    "lang": "text"
                  },
                  {
                    "kind": "text",
                    "value": "  // A信箱中的空位数"
                  }
                ],
                [
                  {
                    "kind": "code",
                    "value": "semaphore Full_B = y;",
                    "block": false,
                    "lang": "text"
                  },
                  {
                    "kind": "text",
                    "value": "  // B信箱中的邮件数"
                  }
                ],
                [
                  {
                    "kind": "code",
                    "value": "semaphore Empty_B = N - y;",
                    "block": false,
                    "lang": "text"
                  },
                  {
                    "kind": "text",
                    "value": "  // B信箱中的空位数"
                  }
                ],
                [
                  {
                    "kind": "code",
                    "value": "semaphore mutex_A = 1;",
                    "block": false,
                    "lang": "text"
                  },
                  {
                    "kind": "text",
                    "value": "  // 用于A信箱的互斥访问"
                  }
                ],
                [
                  {
                    "kind": "code",
                    "value": "semaphore mutex_B = 1;",
                    "block": false,
                    "lang": "text"
                  },
                  {
                    "kind": "text",
                    "value": "  // 用于B信箱的互斥访问"
                  }
                ]
              ]
            },
            {
              "kind": "p",
              "children": [
                {
                  "kind": "group",
                  "children": [
                    {
                      "kind": "text",
                      "value": "（2）A的同步过程："
                    }
                  ]
                }
              ]
            },
            {
              "kind": "code",
              "value": "A {\n    while (TRUE) {\n        P(Full_A);        // 等待A信箱有邮件\n        P(mutex_A);       // 进入A信箱临界区\n        从A的信箱中取出一个邮件；\n        V(mutex_A);       // 离开A信箱临界区\n        V(Empty_A);       // A信箱空位加1\n        回答问题并提出一个新问题；\n        P(Empty_B);       // 等待B信箱有空位\n        P(mutex_B);       // 进入B信箱临界区\n        将新邮件放入B的信箱；\n        V(mutex_B);       // 离开B信箱临界区\n        V(Full_B);        // B信箱邮件数加1\n    }\n}",
              "block": true,
              "lang": "text"
            },
            {
              "kind": "p",
              "children": [
                {
                  "kind": "group",
                  "children": [
                    {
                      "kind": "text",
                      "value": "（3）B的同步过程："
                    }
                  ]
                }
              ]
            },
            {
              "kind": "code",
              "value": "B {\n    while (TRUE) {\n        P(Full_B);        // 等待B信箱有邮件\n        P(mutex_B);       // 进入B信箱临界区\n        从B的信箱中取出一个邮件；\n        V(mutex_B);       // 离开B信箱临界区\n        V(Empty_B);       // B信箱空位加1\n        回答问题并提出一个新问题；\n        P(Empty_A);       // 等待A信箱有空位\n        P(mutex_A);       // 进入A信箱临界区\n        将新邮件放入A的信箱；\n        V(mutex_A);       // 离开A信箱临界区\n        V(Full_A);        // A信箱邮件数加1\n    }\n}",
              "block": true,
              "lang": "text"
            }
          ]
        }
      ]
